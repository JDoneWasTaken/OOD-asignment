          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="635" />
              <mxPoint x="430" y="565" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Validate Quota -> [Valid] -> Lock Seats -->
