        </mxCell>

        <!-- Calc Pricing -> Display Summary -->
        <mxCell id="f10" value="" style="endArrow=open;endSize=8;strokeColor=#000000;html=1;rounded=0;" edge="1" parent="1" source="act_calc_pricing" target="act_display_summary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Display Summary -> Confirm Decision -->
        <mxCell id="f11" value="" style="endArrow=open;endSize=8;strokeColor=#000000;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="act_display_summary" target="dec_confirm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Confirm Decision -> [Discard / Cancel] -->
        <mxCell id="f12_cancel" value="[No / Discard]" style="endArrow=open;endSize=8;strokeColor=#000000;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;" edge="1" parent="1" source="dec_confirm" target="act_discard">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="195" y="942" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="f12_cancel_end" value="" style="endArrow=open;endSize=8;strokeColor=#000000;html=1;rounded=0;" edge="1" parent="1" source="act_discard" target="final_cancel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Confirm Decision -> [Confirm / Yes] -> Display Payment Options -->
        <mxCell id="f12_confirm" value="[Yes / Confirm]" style="endArrow=open;endSize=8;strokeColor=#000000;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;" edge="1" parent="1" source="dec_confirm" target="act_display_payment_opts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Display Payment Options -> Select Payment -->
        <mxCell id="f13" value="" style="endArrow=open;endSize=8;strokeColor=#000000;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="act_display_payment_opts" target="act_select_payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Select Payment -> Gateway: Process Payment -->
        <mxCell id="f14" value="" style="endArrow=open;endSize=8;strokeColor=#000000;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="act_select_payment" target="act_process_payment">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="195" y="1055" />
              <mxPoint x="905" y="1055" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Process Payment -> Payment Decision -->
