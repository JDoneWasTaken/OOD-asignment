          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Payment Decision -> [Failed / Declined] -->
        <mxCell id="f16_fail" value="[Declined / Abort]" style="endArrow=open;endSize=8;strokeColor=#000000;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;" edge="1" parent="1" source="dec_payment" target="act_payment_failed">
          <mxGeometry relative="1" as="geometry">
